# Base URL of the apiflix backend.
ANIGHOST_API_BASE=https://senpaiflix-backend-h8ed.onrender.com


# The backend's middleware.ts only accepts requests whose Origin header is on
# its allowlist. Requests are made server-side, so this is a header we set —
# it never reaches the browser. Must exactly match an entry in that allowlist.
ANIGHOST_API_ORIGIN=https://animextrons.co.in

# This site's own public origin — canonical tags, the sitemap and social
# preview URLs all resolve against it. Leave blank on Vercel: the production
# domain is detected automatically, so previews still point at the real site
# instead of advertising their own throwaway hostname.
ANIGHOST_SITE_ORIGIN=

# Seconds to cache upstream GETs in the route handler.
ANIGHOST_CACHE_SECONDS=300

# ─── Upstash Redis (required for caching) ─────────────────────────────────────
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional — title treatments (the real logo lettering) on the hero and title
# pages, sourced from TMDB. Leave both blank and titles render as plain text;
# nothing else changes. A v4 read token is preferred; a v3 key also works.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=

# TVDB_API_KEY
TVDB_API_KEY=

# Optional signed native-app release links. The Apps page shows a truthful
# "Coming soon" state for any platform without a configured HTTPS URL.
NEXT_PUBLIC_ANIGHOST_WINDOWS_URL=
NEXT_PUBLIC_ANIGHOST_MAC_URL=
NEXT_PUBLIC_ANIGHOST_LINUX_URL=
NEXT_PUBLIC_ANIGHOST_ANDROID_URL=
NEXT_PUBLIC_ANIGHOST_ANDROID_TV_URL=

# ---- Support -----------------------------------------------------------------
# Every value is a hosted checkout URL belonging to a payment provider. Card
# numbers are entered on the provider's page, never on this site: nothing here
# ever receives a card number or CVV, which keeps the project out of PCI scope.
#
# Put {amount} where the provider wants the USD amount in the path; leave it out
# and the amount is appended as ?amount= instead. Only https URLs are used.
#
# Methods with no URL are left out of the picker rather than shown as dead
# buttons, so configuring only the first one is a perfectly good setup.
NEXT_PUBLIC_ANIGHOST_SUPPORT_URL=
NEXT_PUBLIC_ANIGHOST_SUPPORT_PAYPAL_URL=
NEXT_PUBLIC_ANIGHOST_SUPPORT_GOOGLE_URL=
NEXT_PUBLIC_ANIGHOST_SUPPORT_APPLE_URL=

# A recurring checkout. Set this and the panel offers Once / Monthly; leave it
# blank and the choice is not shown, rather than shown and ignored.
NEXT_PUBLIC_ANIGHOST_SUPPORT_MONTHLY_URL=

# Optional community invite. The floating Discord button and the footer link
# both appear only when this is set (or fallback to the default link).
NEXT_PUBLIC_ANIGHOST_DISCORD_URL=https://discord.gg/CW9kFv2SPT

# REQUIRED IN PRODUCTION. Signs every /api/hls link so the stream proxy will
# only fetch URLs this server minted. Without it the proxy is an open relay
# that anyone can point at any public URL, on your bandwidth and your IP.
# Generate one with:  openssl rand -base64 32
ANIGHOST_PROXY_SECRET=
