{
  "cli": {
    "version": ">= 19.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development_phone": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development-phone",
      "env": {
        "EXPO_TV": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development_tv": {
      "extends": "development_phone",
      "channel": "development-tv",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview_phone": {
      "distribution": "internal",
      "channel": "preview-phone",
      "env": {
        "EXPO_TV": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview_tv": {
      "extends": "preview_phone",
      "channel": "preview-tv",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "production_phone": {
      "autoIncrement": true,
      "channel": "production-phone",
      "env": {
        "EXPO_TV": "0"
      }
    },
    "production_tv": {
      "extends": "production_phone",
      "channel": "production-tv",
      "env": {
        "EXPO_TV": "1"
      }
    }
  },
  "submit": {
    "production_phone": {},
    "production_tv": {}
  }
}
