{
  "name": "anighost",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "npx @cloudflare/next-on-pages",
    "preview:cloudflare": "wrangler pages dev .vercel/output/static --compatibility-date=2026-09-05 --compatibility-flags=nodejs_compat",
    "deploy:hls": "wrangler deploy --config hls-worker/wrangler.toml"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.41.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.129.0"
  }
}
